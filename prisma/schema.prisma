generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  REFUNDED
  CANCELLED
}

model User {
  id           String     @id @default(cuid()) @map("_id")
  email        String     @unique
  name         String
  passwordHash String
  role         Role       @default(USER)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  orders       Order[]
  favorites    Favorite[]
  resetTokens  PasswordResetToken[]
}

model PasswordResetToken {
  id        String   @id @default(cuid()) @map("_id")
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Category {
  id       String    @id @default(cuid()) @map("_id")
  name     String    @unique
  slug     String    @unique
  icon     String    @default("frame")
  position Int       @default(0)
  products Product[]
}

model Product {
  id            String      @id @default(cuid()) @map("_id")
  slug          String      @unique
  name          String
  tagline       String
  description   String
  priceCents    Int
  compareCents  Int?
  image         String
  gallery       String[]    @default([])
  badge         String?
  format        String
  creator       String      @default("LumaMarket Studio")
  fileTypes     String      @default("PDF")
  fileSize      String      @default("10 MB")
  features      String[]
  rating        Float       @default(5)
  reviewCount   Int         @default(0)
  published     Boolean     @default(true)
  featured      Boolean     @default(false)
  /// Mall item id when this product is synced from the Partner Store API.
  partnerId     String?     @unique
  partnerMotion Boolean     @default(false)
  categoryId    String
  category      Category    @relation(fields: [categoryId], references: [id])
  orderItems    OrderItem[]
  favorites     Favorite[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([categoryId])
  @@index([published, featured])
}

model Order {
  id         String      @id @default(cuid()) @map("_id")
  number     Int         @unique // from Counter "order" (MongoDB has no autoincrement)
  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  email      String
  firstName  String
  lastName   String
  country    String
  address    String
  city       String
  state      String
  zip        String
  subtotal   Int
  tax        Int
  total      Int
  status     OrderStatus @default(PENDING)
  stripeSessionId       String? @unique
  stripePaymentIntentId String? @unique
  paidAt     DateTime?
  items      OrderItem[]
  createdAt  DateTime    @default(now())

  @@index([userId])
  @@index([status, createdAt])
}

model OrderItem {
  id         String  @id @default(cuid()) @map("_id")
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  priceCents Int
  quantity   Int     @default(1)

  @@index([orderId])
  @@index([productId])
}

model Favorite {
  id        String  @id @default(cuid()) @map("_id")
  userId    String
  productId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model ContactMessage {
  id        String   @id @default(cuid()) @map("_id")
  name      String
  email     String
  topic     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read, createdAt])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid()) @map("_id")
  email     String   @unique
  createdAt DateTime @default(now())
}

/// Editable site content (e.g. key "home" = home page sections), stored as JSON.
model SiteContent {
  key       String   @id @map("_id")
  data      Json
  updatedAt DateTime @updatedAt
}

/// Sequence numbers (e.g. id "order" → next order number).
model Counter {
  id    String @id @map("_id")
  value Int
}
