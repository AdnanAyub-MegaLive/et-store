DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/lumamarket?schema=public"
SESSION_SECRET="generate-a-random-48-byte-base64-string"
APP_URL="http://localhost:3000"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="choose-a-strong-password"

STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."


# Vercel Blob: set automatically on Vercel when a Blob store is connected. Leave empty locally to save uploads to ./uploads.
BLOB_READ_WRITE_TOKEN=

# Cloudflare Turnstile ("I'm not a robot" on the contact form). Leave empty to turn it off.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Mega Live portal Partner Store API (Mega catalog in the admin panel).
# MEGA_API_URL: the portal address, e.g. https://portal.megachat.live
# MEGA_PARTNER_KEY: create it in the portal under Uploads -> Partner keys, allowed for this site's APP_URL.
MEGA_API_URL=https://portal.megachat.live
MEGA_PARTNER_KEY=
# Protects /api/cron/mega-sync (Vercel Cron sends it as a Bearer token).
CRON_SECRET=
